/* ==========================================
   MODELO: SC-CRONOLOGIA (Estados tipo Semáforo)
   ========================================== */
.sc-cronologia {
  width: 100%;
  max-width: 550px;
  background: transparent !important;
  border: 1px solid rgba(150, 150, 150, 0.3);
  border-radius: 12px;
  padding: 20px;
  font-family: 'Quicksand', sans-serif;
  color: inherit;
  box-sizing: border-box;
  margin: 30px auto;
  position: relative;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
}

.cronologia-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px dashed rgba(150, 150, 150, 0.3);
  padding-bottom: 12px;
  margin-bottom: 18px;
}

.cronologia-titulo {
  font-family: var(--yuuki-title, 'Playfair Display'), serif;
  font-size: 22px;
  font-weight: 700;
  color: var(--grupo-color, #d97736);
  text-transform: none;
  letter-spacing: 0.5px;
}

/* Sistema de Semáforo para Estados */
.cronologia-estado {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 20px;
  border: 1px solid currentColor;
}

/* Verde: Activo */
.cronologia-estado.activo {
  color: #2ecc71;
  background: rgba(46, 204, 113, 0.08);
}

/* Amarillo/Naranja: Abandonado / En Pausa */
.cronologia-estado.abandonado {
  color: #f39c12;
  background: rgba(243, 156, 18, 0.08);
}

/* Rojo: Cerrado / Terminado */
.cronologia-estado.cerrado {
  color: #e74c3c;
  background: rgba(231, 76, 60, 0.08);
}

.cronologia-lista {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cronologia-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(150, 150, 150, 0.15);
  border-left: 3px solid var(--grupo-color, #d97736);
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 12px;
  transition: all 0.2s ease;
}

.cronologia-item:hover {
  background: rgba(255, 255, 255, 0.05);
}

.cronologia-link {
  color: inherit;
  text-decoration: none;
  font-weight: 600;
}

.cronologia-link:hover {
  color: var(--grupo-color, #d97736);
  text-decoration: underline;
}

.cronologia-meta-info {
  font-size: 11px;
  opacity: 0.8;
  display: flex;
  gap: 10px;
  align-items: center;
}
